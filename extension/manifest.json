{
  "manifest_version": 3,
  "name": "Browser Bridge",
  "version": "0.1.0",
  "key": "",
  "description": "Browser automation bridge for AI agents",
  "permissions": ["nativeMessaging", "tabs", "activeTab", "scripting", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
